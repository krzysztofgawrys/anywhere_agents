# Agents Anywhere Worker (GitHub Copilot SDK) - standalone compose for remote machines
#
# ⚠️  This is the EXAMPLE/template. Copy it to worker-copilot-compose.yml
#     (which is gitignored) and fill in real secrets there. NEVER commit the
#     real file - keep CF_ACCESS_CLIENT_SECRET and similar out of git.
#
# Two deployment modes. Pick ONE by setting WORKER_MODE in .env:
#
# ── server (default, classic) ───────────────────────────────────────────
#   Worker listens on port 8003. Hub dials it via the URL in workers.json.
#   Use this when hub can reach the worker (LAN, Tailscale, VPC routing,
#   etc.).
#
#   Setup:
#     1. Clone repo on remote machine.
#     2. Run `copilot` on host once to authenticate (creates ~/.copilot/).
#     3. Create .env with UID, GID, WORKER_SECRET matching hub.
#     4. Edit volume mounts for your project directories.
#     5. docker compose -f workers/worker-copilot-compose.yml up -d
#
#   Hub's workers.json entry:
#     {
#       "id": "remote-copilot", "type": "copilot", "label": "Remote",
#       "url": "ws://<this-machine>:8003/ws", "secret": "..."
#     }
#
# ── inbound (reverse mode) ──────────────────────────────────────────────
#   Worker dials OUT to the hub. No inbound port needed. Use this when
#   the worker is in a closed VPC, behind a NAT, or in a corporate
#   network where only egress 443 is allowed.
#
#   Set in .env:
#     WORKER_MODE=inbound
#     HUB_PUBLIC_URL=https://hub.example.com    (publicly reachable hub URL,
#                                                used for control + data WS)
#     WORKER_ID=remote-copilot           (must match workers.json entry)
#     WORKER_LABEL=Remote                (cosmetic)
#     WORKER_SECRET=...                  (same as hub)
#
#   If the hub is behind Cloudflare Access with service-token policies
#   on /worker-register and /worker-data, also set:
#     CF_ACCESS_CLIENT_ID=<service token client id>
#     CF_ACCESS_CLIENT_SECRET=<service token client secret>
#
#   Hub's workers.json entry (note: no "url" needed):
#     {
#       "id": "remote-copilot", "type": "copilot", "label": "Remote",
#       "mode": "inbound", "secret": "..."
#     }
#
#   In inbound mode the `ports:` block below can be removed - the worker
#   doesn't need a listening port at all. Leaving it exposes /health for
#   liveness checks but the /ws endpoint will actively refuse connections.

services:
  worker-copilot:
    image: ghcr.io/krzysztofgawrys/anywhere-agents/worker-copilot:latest
    container_name: claude-web-worker-copilot
    restart: unless-stopped
    user: "${UID:-1000}:${GID:-1000}"
    ports:
      # Only meaningful in server mode. In inbound mode the /ws endpoint
      # refuses connections (logged on startup); /health stays available
      # for liveness probes. Comment this out for a fully closed-ingress
      # inbound deployment.
      - "${WORKER_COPILOT_PORT:-8003}:8003"
    environment:
      - HOME=/home/app
      - WORKER_SECRET=${WORKER_SECRET:-changeme}
      - COPILOT_HOME=/home/app/.copilot
      # Separate SQLite from worker-claude to keep each worker's project list
      # independent (different scanners, different on-disk sources).
      - CLAUDE_WEB_DB_PATH=/home/app/.claude-web/worker-copilot.sqlite
      # ── Reverse mode (uncomment to enable) ──────────────────────────
      - WORKER_MODE=inbound
      - HUB_PUBLIC_URL=${HUB_PUBLIC_URL:-https://claude.gawrys.cloud}
      - WORKER_ID=${WORKER_ID:-remote-copilot}
      - WORKER_LABEL=${WORKER_LABEL:-Remote}
      - WORKER_TYPE=copilot
      # ── Optional: hub behind Cloudflare Access with service tokens ─
      # Provide real values via env (.env) - do NOT hardcode them here.
      - CF_ACCESS_CLIENT_ID=${CF_ACCESS_CLIENT_ID:-}
      - CF_ACCESS_CLIENT_SECRET=${CF_ACCESS_CLIENT_SECRET:-}
      # ── Optional: GitHub PAT (skips `copilot` login requirement) ────
      # Set this to a PAT with Copilot scope to bypass any browser-side
      # device-code bootstrap when that flow lands for worker-copilot.
      # Useful for CI / Kubernetes / Vault deployments. When set, the
      # worker boots straight without needing `copilot` login on host.
      # - COPILOT_GITHUB_TOKEN=${COPILOT_GITHUB_TOKEN:-}
    volumes:
      # Copilot auth + session state (from `copilot` login on host).
      # OPTIONAL when COPILOT_GITHUB_TOKEN is set above. Keep the mount
      # if you want Copilot's local session history across restarts.
      - claude-web-state:/home/app/.copilot
      # Worker DB (projects index, separate from worker-claude) - create
      # the dir first: mkdir -p ~/.claude-web
      - claude-web-state:/home/app/.claude-web
      # Git credentials
      - ${HOME}/.ssh:/home/app/.ssh
      - ${HOME}/.gitconfig:/home/app/.gitconfig:ro
      # ── Project roots ──────────────────────────────────────────────────
      # Mount at the SAME absolute path as on host so workspace_path recorded
      # by Copilot inside ~/.copilot/session-state/.../workspace.* resolves
      # correctly inside the container.
      - ${HOME}/code:${HOME}/code

# ── Named volumes ────────────────────────────────────────────────────────────
volumes:
  # Private claude-web state - bootstrap credentials + project DB.
  # See worker-claude.volumes for the design note.
  claude-web-state:
