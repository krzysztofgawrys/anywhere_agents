#!/usr/bin/env bash
# Block pushes whose new commits contain secrets. Reads the ref updates git
# feeds on stdin and scans each pushed range.
ROOT="$(git rev-parse --show-toplevel)"
ZERO="0000000000000000000000000000000000000000"
status=0

while read -r local_ref local_oid remote_ref remote_oid; do
  [ -z "${local_oid:-}" ] && continue
  [ "$local_oid" = "$ZERO" ] && continue            # branch deletion - nothing to scan
  if [ "$remote_oid" = "$ZERO" ]; then
    range="$local_oid --not --remotes"              # new branch: only commits not yet on any remote
  else
    range="$remote_oid..$local_oid"
  fi
  "$ROOT/.githooks/scan-secrets.sh" range "$range" || status=1
done

exit $status
