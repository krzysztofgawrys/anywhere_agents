# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/

# Node
node_modules/
frontend/dist/

# Build output (frontend → backend static)
backend/src/static/

# Frontend production build (volume-mounted into hub at runtime; rebuilt by `npm run build`)
frontend-dist/

# Local Claude Code state (per-machine settings, not for sharing)
.claude/

# Environment (secrets - never commit)
.env
docker/.env

# Local config that may hold real secrets - copy from the matching *.example
# and fill in. The real files stay on each machine, never in git; only the
# *.example templates are committed.
worker-windows/start.ps1
workers/worker-claude-compose.yml
workers/worker-codex-compose.yml
workers/worker-copilot-compose.yml
workers.json

# Local-only elec worker (electronics/USB toolchain). Co-located dev worker
# specific to one machine's hardware; kept out of the shared repo.
compose.override.yml
docker/worker-claude-elec.Dockerfile

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Test artifacts
.test/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# CodeQL local analysis (databases + SARIF results)
.codeql-local/

# TS build info
frontend/tsconfig.tsbuildinfo
