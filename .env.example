# ── Claude Web configuration ──────────────────────────────────────────────────
# Copy to .env and fill in. Used by both docker compose and scripts/start.sh.

# ── Docker: UID/GID ──────────────────────────────────────────────────────────
# Must match your host user so file ownership on mounted volumes is correct.
# Find yours with: id -u && id -g
UID=1000
GID=1000

# ── Docker: port binding ─────────────────────────────────────────────────────
# Default: localhost only (cloudflared connects here).
# Change to "0.0.0.0:8001" to expose on all interfaces.
PORT=127.0.0.1:8001

# ── Environment (dev | prod) ──────────────────────────────────────────────────
# "prod" = auth mandatory (fail-closed if CF vars missing).
# "dev"  = auth bypassed when CF vars unset (default).
CLAUDE_WEB_ENV=dev

# ── Cloudflare Access (required in prod) ──────────────────────────────────────
# Zero Trust → Access → Applications → your app
# CF_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
# CF_ACCESS_AUD=your-application-audience-tag
# CF_ACCESS_ALLOWED_EMAILS=you@example.com

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite path. Default: ~/.claude-web/db.sqlite
# Inside Docker, ~ = /home/app (mapped via volume to host's ~/.claude-web/)
# CLAUDE_WEB_DB_PATH=/home/you/.claude-web/db.sqlite

# ── Worker auth ──────────────────────────────────────────────────────────────
# Shared secret between hub and worker(s). Change from default in production.
WORKER_SECRET=changeme

# ── Cloudflare Tunnel (if running via docker/compose.yml) ─────────────────────
# TUNNEL_TOKEN=your-tunnel-token

# ── Project Knowledge (agent-curated RAG memory, worker-claude) ───────────────
# Per-project knowledge base the agent searches before answering and curates
# itself. Data stays on the worker (SQLite). All optional - sensible defaults.
#
# Master switch (default: enabled).
# KNOWLEDGE_ENABLED=true
# Embeddings backend: "local" (fastembed/ONNX, on-box, no vendor) or "voyage"
# (hosted - sends text to api.voyageai.com). Default: local.
# KNOWLEDGE_EMBEDDINGS=local
# Embedding model. Local default is English-leaning; for non-English projects
# set a multilingual model from fastembed's supported list.
# KNOWLEDGE_EMBED_MODEL=BAAI/bge-small-en-v1.5
# VOYAGE_API_KEY=                 # required only when KNOWLEDGE_EMBEDDINGS=voyage
# Retrieval depth and near-duplicate skip threshold.
# KNOWLEDGE_TOPK=5
# KNOWLEDGE_DEDUP_THRESHOLD=0.95
# Idle seconds before a background consolidation turn (0 = disabled). The agent
# only consolidates if it did real work (edited files) since the last one.
# KNOWLEDGE_CONSOLIDATE_IDLE_SEC=600

# ── Reverse worker mode (per remote worker, in its own .env) ──────────────────
# Worker dials OUT to the hub - no inbound port required on the worker box.
# Use when the worker sits in a closed VPC, behind NAT, or in a corporate
# network where only egress 443 is allowed.
#
# Set on the WORKER side (not the hub):
# WORKER_MODE=inbound
# HUB_PUBLIC_URL=https://hub.example.com  # publicly reachable hub URL (CF Tunnel)
# WORKER_ID=remote-copilot                # must match workers.json entry on hub
# WORKER_LABEL=Remote                     # cosmetic
# WORKER_TYPE=copilot                     # "claude" / "copilot" / "codex"
#
# If the hub is behind Cloudflare Access with a service-token policy on
# /worker-register and /worker-data, also set (worker side):
# CF_ACCESS_CLIENT_ID=<service token client id>
# CF_ACCESS_CLIENT_SECRET=<service token client secret>
#
# On the HUB side, workers.json entry for an inbound worker has no `url`:
#   { "id": "remote-copilot", "type": "copilot", "label": "Remote",
#     "mode": "inbound", "secret": "..." }
